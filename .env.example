# Konfigurasi situs CLAU AI (dibaca saat `npm run build`). Salin ke .env lalu isi.
# Semua nilai di bawah masih PLACEHOLDER; kosongkan = pakai teks placeholder di src/data/site.ts.

# Domain situs ini (canonical, sitemap, gambar share). Tanpa garis miring di akhir.
VITE_SITE_URL=https://domain-anda.com
# Dashboard klien (repo clau-agent). Tombol "Mulai sekarang" → $VITE_APP_URL/daftar, "Masuk" → $VITE_APP_URL/login
VITE_APP_URL=https://app.domain-anda.com

# Identitas usaha (footer & halaman legal)
VITE_LEGAL_NAME=[Nama usaha resmi]
VITE_ADDRESS=[Alamat usaha]
VITE_CONTACT_EMAIL=halo@domain-anda.com
VITE_PRIVACY_EMAIL=privasi@domain-anda.com
# WhatsApp format internasional tanpa + (mis. 6281234567890). Kosong = tombol WA disembunyikan.
VITE_WHATSAPP=

# Halaman legal
VITE_LEGAL_EFFECTIVE_DATE=[Tanggal berlaku]
# Isi 1 setelah Kebijakan Privasi & Syarat Layanan ditinjau konsultan hukum (label "Draf" hilang).
VITE_LEGAL_REVIEWED=0
# Batas waktu proses permintaan hapus data (hari kerja)
VITE_DATA_DELETION_DAYS=14
